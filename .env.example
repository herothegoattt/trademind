# TradeMind AI — Environment Variables
# Copy to .env and fill in values

# =============================================================================
# DATABASE
# =============================================================================
# SQLite (local dev default)
DATABASE_URL=sqlite:///./trademind.db
# PostgreSQL (production — recommended for Azure)
# DATABASE_URL=postgresql://user:password@host:5432/trademind

# =============================================================================
# AUTH / SECURITY
# =============================================================================
# Generate with: openssl rand -hex 32
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# =============================================================================
# CORS
# =============================================================================
# Comma-separated list of allowed origins (set your Vercel frontend URL)
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# =============================================================================
# AI KEYS
# =============================================================================
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# =============================================================================
# GOOGLE SIGN-IN (optional)
# =============================================================================
GOOGLE_CLIENT_ID=

# =============================================================================
# NEWS APIs (optional — uses mock data if not set)
# =============================================================================
NEWSDATA_API_KEY=
NEWSAPI_API_KEY=

# =============================================================================
# STRIPE PAYMENTS
# =============================================================================
# Get keys from https://dashboard.stripe.com/apikeys
# Use sk_test_... keys for dev, sk_live_... for production
STRIPE_SECRET_KEY=
# Webhook signing secret — from Stripe Dashboard → Developers → Webhooks
# Endpoint URL must be: https://yourdomain.com/api/v1/payments/webhook
# Events to listen: checkout.session.completed, customer.subscription.updated,
#                   customer.subscription.deleted, invoice.payment_succeeded
STRIPE_WEBHOOK_SECRET=
# Price IDs — create products in Stripe Dashboard → Products, then paste IDs here
STRIPE_PRICE_EDGE_MONTHLY=price_
STRIPE_PRICE_EDGE_ANNUAL=price_
STRIPE_PRICE_APEX_MONTHLY=price_
STRIPE_PRICE_APEX_ANNUAL=price_

# =============================================================================
# MARKET DATA APIs (optional)
# =============================================================================
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
TRADING_ECONOMICS_API_KEY=
FOREXFACTORY_API_URL=
FOREXFACTORY_API_KEY=

# =============================================================================
# APP
# =============================================================================
DEBUG=false

# =============================================================================
# FRONTEND (Next.js — set in Vercel dashboard, not here)
# =============================================================================
NEXT_PUBLIC_API_URL=
NEXTAUTH_SECRET=
