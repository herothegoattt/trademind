# TradeMind AI — Environment Variables
# Copy to .env and fill in values

# =============================================================================
# DATABASE
# =============================================================================
# SQLite (local dev default)
DATABASE_URL=sqlite:///./trademind.db
# PostgreSQL (production — recommended for Azure)
# DATABASE_URL=postgresql://user:password@host:5432/trademind

# =============================================================================
# AUTH / SECURITY
# =============================================================================
# Generate with: openssl rand -hex 32
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# =============================================================================
# CORS
# =============================================================================
# Comma-separated list of allowed origins (set your Vercel frontend URL)
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# =============================================================================
# AI KEYS
# =============================================================================
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# =============================================================================
# GOOGLE SIGN-IN (optional)
# =============================================================================
GOOGLE_CLIENT_ID=

# =============================================================================
# NEWS APIs (optional — uses mock data if not set)
# =============================================================================
NEWSDATA_API_KEY=
NEWSAPI_API_KEY=

# =============================================================================
# LEMON SQUEEZY PAYMENTS
# =============================================================================
# Get keys from https://app.lemonsqueezy.com/settings/api
LEMONSQUEEZY_API_KEY=
# Your store ID — from Lemon Squeezy Dashboard
LEMONSQUEEZY_STORE_ID=
# Webhook signing secret — from Lemon Squeezy Dashboard → Settings → Webhooks
# Endpoint URL must be: https://yourdomain.com/api/v1/payments/webhook
# Events to listen: order_created, subscription_created, subscription_updated, subscription_cancelled
LEMONSQUEEZY_WEBHOOK_SECRET=
# Test mode: when true, bypasses Lemon Squeezy checkout and activates plans directly
# Set to false only when your Lemon Squeezy store is live and verified
LEMONSQUEEZY_TEST_MODE=true
# Variant IDs — create products in Lemon Squeezy Dashboard, then paste IDs here
LS_VARIANT_EDGE_MONTHLY=
LS_VARIANT_EDGE_ANNUAL=
LS_VARIANT_APEX_MONTHLY=
LS_VARIANT_APEX_ANNUAL=

# =============================================================================
# MARKET DATA APIs (optional)
# =============================================================================
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
TRADING_ECONOMICS_API_KEY=
FOREXFACTORY_API_URL=
FOREXFACTORY_API_KEY=

# =============================================================================
# APP
# =============================================================================
DEBUG=false

# =============================================================================
# FRONTEND (Next.js — set in Vercel dashboard, not here)
# =============================================================================
NEXT_PUBLIC_API_URL=
NEXTAUTH_SECRET=
