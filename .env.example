# TradeMind AI — example env
# Copy to .env and set values

# =============================================================================
# GEMINI AI - Google Gemini Pro API Key (БЕСПЛАТНО!)
# Получить: https://makersuite.google.com/app/apikey
# Это активирует реальный AI для всех функций
# =============================================================================
GEMINI_API_KEY=your_gemini_api_key_here

# Database (default SQLite; for Postgres use postgresql://user:pass@host/dbname)
DATABASE_URL=sqlite:///./trademind.db

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Auth (use openssl rand -hex 32 in production)
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Google Sign-In (optional; for /auth/google)
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# News APIs (optional)
# NEWSDATA_API_KEY=
# NEWSAPI_API_KEY=

# Market Data APIs (optional)
# OANDA_API_KEY=
# OANDA_ACCOUNT_ID=
# TRADING_ECONOMICS_API_KEY=

# Optional
DEBUG=false

