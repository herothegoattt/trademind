# Environment variables for frontend
# If you use TradingEconomics API, set key below
TRADING_ECONOMICS_KEY=

# Backend base URL if needed
NEXT_PUBLIC_API_URL=http://localhost:8000

# Lemon Squeezy — store ID
NEXT_PUBLIC_LS_STORE_ID=

# PostHog (retention & analytics) — get token from https://app.posthog.com/project/settings
NEXT_PUBLIC_POSTHOG_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
